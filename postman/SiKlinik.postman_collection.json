              "raw": "{{baseUrl}}/poli",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "poli"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('pesan minta token', () => pm.expect(pm.response.json().message).to.include('Token'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
