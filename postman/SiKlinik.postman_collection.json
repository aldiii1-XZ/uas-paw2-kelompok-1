          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('token JWT diterima', () => pm.expect(b.token).to.be.a('string').and.not.empty);",
                  "pm.test('role admin', () => pm.expect(b.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('token', b.token);"
