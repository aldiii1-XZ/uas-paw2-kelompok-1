{
  "info": {
    "name": "SiKlinik API - UAS PAW2 Kelompok 1",
    "description": "Koleksi uji seluruh endpoint SiKlinik (Poli, Dokter, Pendaftaran). Jalankan berurutan: folder Health → Poli → Dokter → Pendaftaran.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('tanggalHariIni', new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api"
    },
    {
      "key": "poliId",
      "value": ""
    },
    {
      "key": "dokterId",
      "value": ""
    },
    {
      "key": "pendaftaranId",
      "value": ""
    },
    {
      "key": "tanggalHariIni",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Admin Klinik\",\n  \"email\": \"{{emailUji}}\",\n  \"password\": \"{{passwordUji}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('emailUji')) pm.collectionVariables.set('emailUji', 'admin' + Date.now() + '@uji.local');",
                  "pm.collectionVariables.set('passwordUji', 'rahasia123');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('token JWT diterima', () => pm.expect(b.token).to.be.a('string').and.not.empty);",
                  "pm.test('password tidak ikut dikirim', () => pm.expect(b.user.password).to.be.undefined);",
                  "pm.test('email tersimpan lowercase', () => pm.expect(b.user.email).to.eql(pm.collectionVariables.get('emailUji')));",
                  "pm.collectionVariables.set('token', b.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Register duplikat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Admin Klinik\",\n  \"email\": \"{{emailUji}}\",\n  \"password\": \"{{passwordUji}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('pesan email sudah dipakai', () => pm.expect(pm.response.json().message).to.include('email'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Login",
