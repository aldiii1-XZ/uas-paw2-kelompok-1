              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status selesai', () => pm.expect(b.status).to.eql('selesai'));",
                  "pm.test('selesaiAt terisi', () => pm.expect(b.selesaiAt).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
