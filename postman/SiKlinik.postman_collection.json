              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"selesai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pendaftaran/{{pendaftaranId}}/status",
              "host": [
